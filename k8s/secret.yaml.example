apiVersion: v1
kind: Secret
metadata:
  name: cozyroom-secret
  namespace: cozyroom-k8s
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME"
  OPENROUTER_API_KEY: ""
  DEEPSEEK_API_KEY: ""
  GEMINI_API_KEY: ""
  GITHUB_TOKEN: ""
---
# Owner password: choose a NEW value, never reuse an old one, never commit it.
# kubectl -n cozyroom-k8s create secret generic cozyroom-owner --from-literal=password='<new password>'
apiVersion: v1
kind: Secret
metadata:
  name: cozyroom-owner
  namespace: cozyroom-k8s
type: Opaque
stringData:
  password: ""
