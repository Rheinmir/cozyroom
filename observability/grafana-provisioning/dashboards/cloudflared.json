{
  "title": "Cloudflare Tunnel — homelab",
  "uid": "cloudflared-homelab",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["cloudflare", "tunnel"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tunnel Status",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      },
      "targets": [{ "expr": "up{job=\"cloudflared\"}", "legendFormat": "Status" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Streams",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "blue" }] }, "unit": "short" }
      },
      "targets": [{ "expr": "sum(cloudflared_tunnel_active_streams)", "legendFormat": "Streams" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request Rate (5m)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }] } }
      },
      "targets": [{ "expr": "sum(rate(cloudflared_tunnel_total_requests[5m]))", "legendFormat": "req/s" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.01, "color": "orange" }, { "value": 0.1, "color": "red" }] }
        }
      },
      "targets": [{ "expr": "sum(rate(cloudflared_tunnel_request_errors[5m]))", "legendFormat": "err/s" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (tunnel_id) (rate(cloudflared_tunnel_total_requests[5m]))", "legendFormat": "total — {{tunnel_id}}" },
        { "expr": "sum by (tunnel_id) (rate(cloudflared_tunnel_request_errors[5m]))", "legendFormat": "errors — {{tunnel_id}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active Streams",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 15 } }
      },
      "targets": [
        { "expr": "sum by (connection_id) (cloudflared_tunnel_active_streams)", "legendFormat": "conn {{connection_id}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RTT to Cloudflare Edge (p50 / p99)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(cloudflared_tunnel_timer_rtt_seconds_bucket[5m])))", "legendFormat": "p50 RTT" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(cloudflared_tunnel_timer_rtt_seconds_bucket[5m])))", "legendFormat": "p99 RTT" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP Response Codes (rate 5m)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "expr": "sum by (status_code) (rate(cloudflared_tunnel_response_by_code[5m]))", "legendFormat": "HTTP {{status_code}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Process — CPU & Memory",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Memory" }, "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.axisPlacement", "value": "right" }] },
          { "matcher": { "id": "byName", "options": "CPU" }, "properties": [{ "id": "unit", "value": "percentunit" }] }
        ]
      },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"cloudflared\"}[1m])", "legendFormat": "CPU" },
        { "expr": "process_resident_memory_bytes{job=\"cloudflared\"}", "legendFormat": "Memory" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10 } }
      },
      "targets": [
        { "expr": "go_goroutines{job=\"cloudflared\"}", "legendFormat": "goroutines" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ]
}
