            {"order": 3, "actor": "scanner.go", "action": "Derive IDs: artistID=id8(artist), albumID=id8(artistID+albumTitle), trackID=id8(albumID+filename)"},
            {"order": 4, "actor": "scanner.go", "action": "Extract embedded cover art → write coversDir/<albumID>.jpg"},
            {"order": 5, "actor": "scanner.go", "action": "Upsert artist, album, track to Postgres (ON CONFLICT DO NOTHING for albums/artists)"},
            {"order": 6, "actor": "scanner.go", "action": "Detect YouTube files (baseName len==11) → if cover missing: go downloadYTThumbnail(baseName, dest)"},
            {"order": 7, "actor": "downloadYTThumbnail", "action": "Async: try maxresdefault → hqdefault → mqdefault from img.youtube.com/vi/<ytid>/<size>.jpg"}
          ],
          "outputs": ["DB: artists/albums/tracks rows", "covers/<albumID>.jpg"],
          "errors": ["YT thumbnail fetch fails silently (goroutine) → cover remains missing", "Read-only musicPath → yt-dlp can't write thumbnails during download"]
        },
        {
          "id": "flow:cover-serve",
          "name": "Cover Serving",
          "trigger": {"type": "http", "method": "GET", "path": "/api/covers/:id"},
          "steps": [
            {"order": 1, "actor": "handler.go:cover()", "action": "Validate id: hex16 or yt:<ytid> prefix"},
            {"order": 2a, "actor": "handler.go", "action": "If yt: prefix → singleflight fetch from i.ytimg.com (maxres→hq→mq fallback) → return JPEG or HTTP 503"},
            {"order": 2b, "actor": "handler.go", "action": "If hex16 → serveResizedImage(coversDir, id): resize to 400px if >800px, Cache-Control: max-age=31536000"},
            {"order": 3, "actor": "frontend:PlayerBar", "action": "On HTTP 503: retry up to 4× with 2/4/6/8s backoff"}
          ],
          "errors": ["HTTP 503 returned (not 200+placeholder) so onError fires → retry"]
